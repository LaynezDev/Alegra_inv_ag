# Configuración de base de datos MySQL (ejemplo local XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/alegra_db"

# ========================================================
# Configuración de Firebase Client (Web App)
# Obtenida en: Firebase Console > Configuración del Proyecto > General > Tus apps (Web)
# ========================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-proyecto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef..."

# ========================================================
# Configuración de Firebase Admin SDK (Servidor)
# Obtenida en: Firebase Console > Configuración del Proyecto > Cuentas de servicio > Generar nueva clave privada
# ========================================================
FIREBASE_PROJECT_ID="tu-proyecto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"

# Opcional: Si prefieres pasar el archivo JSON completo en una sola variable:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# ========================================================
# Seguridad y PIN de Acceso al Terminal / POS
# ========================================================
ADMIN_PIN="1219"
