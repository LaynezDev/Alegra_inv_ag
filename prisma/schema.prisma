datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  municipalities Municipality[]
  customers      Customer[]

  @@map("departments")
}

model Municipality {
  id           Int        @id @default(autoincrement())
  departmentId Int        @map("department_id")
  name         String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  customers    Customer[]

  @@unique([departmentId, name])
  @@map("municipalities")
}

model Package {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  packageType   String    @map("package_type") // caja, bolsa, costal, palet
  costPrice     Decimal   @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  invoiceNumber String    @map("invoice_number")
  totalWeight   Decimal?  @map("total_weight") @db.Decimal(10, 3)
  status        String    @default("recibido") // recibido, en_desglose, agotado
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  products      Product[]

  @@map("packages")
}

model Product {
  id             Int         @id @default(autoincrement())
  packageId      Int         @map("package_id")
  barcode        String      @unique
  name           String
  weight         Decimal?    @db.Decimal(10, 3)
  calculatedCost Decimal?    @default(0.00) @map("calculated_cost") @db.Decimal(12, 2)
  salePrice      Decimal     @map("sale_price") @db.Decimal(12, 2)
  photos         String?     @db.LongText // JSON array of photo URLs
  status         String      @default("disponible") // disponible, apartado, vendido, dado_de_baja
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  package        Package     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]

  @@index([barcode])
  @@index([status])
  @@map("products")
}

model Customer {
  id               Int          @id @default(autoincrement())
  barcode          String       @unique
  fullName         String       @map("full_name")
  tiktokUsername   String?      @map("tiktok_username")
  instagramUsername String?     @map("instagram_username")
  facebookUsername String?      @map("facebook_username")
  phonePrimary     String       @map("phone_primary")
  phoneSecondary   String?      @map("phone_secondary")
  fullAddress      String       @map("full_address") @db.Text
  addressReference String?      @map("address_reference") @db.Text
  departmentId     Int          @map("department_id")
  municipalityId   Int          @map("municipality_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  department       Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  municipality     Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  orders           Order[]

  @@index([phonePrimary])
  @@map("customers")
}

model Order {
  id            Int            @id @default(autoincrement())
  orderNumber   String         @unique @map("order_number")
  customerId    Int            @map("customer_id")
  status        String         @default("pendiente_pago") // pendiente_pago, pagado, enviado, entregado, cancelado
  subtotal      Decimal        @default(0.00) @db.Decimal(12, 2)
  totalDiscount Decimal        @default(0.00) @map("total_discount") @db.Decimal(12, 2)
  totalAmount   Decimal        @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      OrderPayment[]

  @@index([status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  productId      Int      @map("product_id")
  originalPrice  Decimal  @map("original_price") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice     Decimal  @map("final_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("order_items")
}

model OrderPayment {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  referenceNumber String   @map("reference_number")
  paymentMethod   String   @default("transferencia") @map("payment_method") // transferencia, deposito, efectivo, otro
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now()) @map("payment_date")
  notes           String?
  receiptImageUrl String?  @map("receipt_image_url")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([referenceNumber])
  @@map("order_payments")
}
